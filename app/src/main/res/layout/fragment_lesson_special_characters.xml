<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- Standardized Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/stylizedNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学習"
            android:textColor="#3E6868"
            android:textSize="50sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/inspirationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:text="Lesson 4"
            android:textColor="#5E5E5E"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/stylizedNumber"
            app:layout_constraintTop_toTopOf="@id/stylizedNumber" />

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Special Characters"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/inspirationLabel"
            app:layout_constraintTop_toBottomOf="@id/inspirationLabel" />

        <ImageButton
            android:id="@+id/btnBackLesson"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#C1AB85"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/inspirationLabel"
            app:layout_constraintBottom_toBottomOf="@id/mainTitle"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Intro Paragraph -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Special Characters"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/lesson_special_intro"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Vu Character -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                android:layout_marginTop="16dp">
                <GridLayout
                    style="@style/HiraganaGridStyle"
                    android:columnCount="1">
                    <TextView style="@style/GridCharStyle"
                        android:text="ヴ\n(Vu)"
                        android:textSize="32sp"
                        android:padding="24dp"
                        android:textStyle="bold"/>
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_special_v_vu"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Small U -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                android:layout_marginTop="16dp">
                <GridLayout
                    style="@style/HiraganaGridStyle"
                    android:columnCount="1">
                    <TextView style="@style/GridCharStyle"
                        android:text="ぅ\n(Small U)"
                        android:textSize="32sp"
                        android:padding="24dp"
                        android:textStyle="bold"/>
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_special_small_u"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Long Vowel -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                android:layout_marginTop="16dp">
                <GridLayout
                    style="@style/HiraganaGridStyle"
                    android:columnCount="2">
                    <TextView style="@style/GridCharStyle"
                        android:text="―\n(Long Vowel)"
                        android:textSize="24sp"
                        android:padding="20dp"
                        android:textStyle="bold"/>
                    <TextView style="@style/GridCharStyle"
                        android:text="ー\n(Long Vowel)"
                        android:textSize="24sp"
                        android:padding="20dp"
                        android:textStyle="bold"/>
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_special_chouonpu"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Wave Dash -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                android:layout_marginTop="16dp">
                <GridLayout
                    style="@style/HiraganaGridStyle"
                    android:columnCount="1">
                    <TextView style="@style/GridCharStyle"
                        android:text="～\n(Wave Dash)"
                        android:textSize="32sp"
                        android:padding="24dp"
                        android:textStyle="bold"/>
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_special_wave"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Punctuation -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                android:layout_marginTop="16dp">
                <GridLayout
                    style="@style/HiraganaGridStyle"
                    android:columnCount="2">
                    <TextView style="@style/GridCharStyle"
                        android:text="！"
                        android:textSize="32sp"
                        android:padding="20dp"
                        android:textStyle="bold"/>
                    <TextView style="@style/GridCharStyle"
                        android:text="？"
                        android:textSize="32sp"
                        android:padding="20dp"
                        android:textStyle="bold"/>
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_special_exclamation_question"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quotation Marks -->
            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                android:layout_marginTop="16dp">
                <GridLayout
                    style="@style/HiraganaGridStyle"
                    android:columnCount="2">
                    <TextView style="@style/GridCharStyle"
                        android:text="「\n(Open)"
                        android:textSize="32sp"
                        android:padding="20dp"
                        android:textStyle="bold"/>
                    <TextView style="@style/GridCharStyle"
                        android:text="」\n(Close)"
                        android:textSize="32sp"
                        android:padding="20dp"
                        android:textStyle="bold"/>
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                style="@style/ChartCardStyle"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                android:layout_marginBottom="32dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_special_quotes"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
