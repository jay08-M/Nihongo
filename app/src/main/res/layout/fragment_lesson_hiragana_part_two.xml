<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- Standardized Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/stylizedNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学習"
            android:textColor="#3E6868"
            android:textSize="50sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/inspirationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:text="Lesson 2"
            android:textColor="#5E5E5E"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/stylizedNumber"
            app:layout_constraintTop_toTopOf="@id/stylizedNumber" />

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hiragana Part 2"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/inspirationLabel"
            app:layout_constraintTop_toBottomOf="@id/inspirationLabel" />

        <ImageButton
            android:id="@+id/btnBackLesson"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#C1AB85"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/inspirationLabel"
            app:layout_constraintBottom_toBottomOf="@id/mainTitle"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Intro Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Introduction"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/lesson_hiragana_2_intro"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ha-Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="Ha Row"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="a" />
                    <TextView style="@style/GridHeaderStyle" android:text="i" />
                    <TextView style="@style/GridHeaderStyle" android:text="u" />
                    <TextView style="@style/GridHeaderStyle" android:text="e" />
                    <TextView style="@style/GridHeaderStyle" android:text="o" />
                    <TextView style="@style/GridCharStyle" android:text="は\n(ha)" />
                    <TextView style="@style/GridCharStyle" android:text="ひ\n(hi)" />
                    <TextView style="@style/GridCharStyle" android:text="ふ\n(fu)" />
                    <TextView style="@style/GridCharStyle" android:text="へ\n(he)" />
                    <TextView style="@style/GridCharStyle" android:text="ほ\n(ho)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_hiragana_paragraph_ha"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ma-Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="Ma Row"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="a" />
                    <TextView style="@style/GridHeaderStyle" android:text="i" />
                    <TextView style="@style/GridHeaderStyle" android:text="u" />
                    <TextView style="@style/GridHeaderStyle" android:text="e" />
                    <TextView style="@style/GridHeaderStyle" android:text="o" />
                    <TextView style="@style/GridCharStyle" android:text="ま\n(ma)" />
                    <TextView style="@style/GridCharStyle" android:text="み\n(mi)" />
                    <TextView style="@style/GridCharStyle" android:text="む\n(mu)" />
                    <TextView style="@style/GridCharStyle" android:text="め\n(me)" />
                    <TextView style="@style/GridCharStyle" android:text="も\n(mo)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_hiragana_paragraph_ma"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ra-Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="Ra Row"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="a" />
                    <TextView style="@style/GridHeaderStyle" android:text="i" />
                    <TextView style="@style/GridHeaderStyle" android:text="u" />
                    <TextView style="@style/GridHeaderStyle" android:text="e" />
                    <TextView style="@style/GridHeaderStyle" android:text="o" />
                    <TextView style="@style/GridCharStyle" android:text="ら\n(ra)" />
                    <TextView style="@style/GridCharStyle" android:text="り\n(ri)" />
                    <TextView style="@style/GridCharStyle" android:text="る\n(ru)" />
                    <TextView style="@style/GridCharStyle" android:text="れ\n(re)" />
                    <TextView style="@style/GridCharStyle" android:text="ろ\n(ro)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_hiragana_paragraph_ra"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Ya-Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="Ya Row"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="a" />
                    <TextView style="@style/GridHeaderStyle" android:text="u" />
                    <TextView style="@style/GridHeaderStyle" android:text="o" />
                    <TextView style="@style/GridCharStyle" android:text="や\n(ya)" />
                    <TextView style="@style/GridCharStyle" android:text="ゆ\n(yu)" />
                    <TextView style="@style/GridCharStyle" android:text="よ\n(yo)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_hiragana_paragraph_ya"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Wa & N Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="Wa &amp; N Row"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="a" />
                    <TextView style="@style/GridHeaderStyle" android:text="o" />
                    <TextView style="@style/GridHeaderStyle" android:text="n" />
                    <TextView style="@style/GridCharStyle" android:text="わ\n(wa)" />
                    <TextView style="@style/GridCharStyle" android:text="を\n(wo)" />
                    <TextView style="@style/GridCharStyle" android:text="ん\n(n)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lesson_hiragana_paragraph_wa_n"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
