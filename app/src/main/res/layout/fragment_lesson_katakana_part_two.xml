<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- Standardized Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/stylizedNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="学習"
            android:textColor="#3E6868"
            android:textSize="50sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/inspirationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:text="Lesson 6"
            android:textColor="#5E5E5E"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/stylizedNumber"
            app:layout_constraintTop_toTopOf="@id/stylizedNumber" />

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Katakana Part 2"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/inspirationLabel"
            app:layout_constraintTop_toBottomOf="@id/inspirationLabel" />

        <ImageButton
            android:id="@+id/btnBackLesson"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#C1AB85"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/inspirationLabel"
            app:layout_constraintBottom_toBottomOf="@id/mainTitle"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Intro Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upgraded Katakana"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="Good news! The upgrade system you learned for Hiragana works exactly the same way here!\n\nJust like before, adding two small strokes (tenten) or a tiny bubble (maru) changes the sound. Since Katakana is mostly for foreign loanwords, these voiced sounds are everywhere from food brands to tech terms!"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Mnemonics Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#3E6868"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Let's refresh your memory with these tricks:"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="- K becomes G\n- S becomes Z\n- T becomes D\n- H becomes B\n- H becomes P\n\nRemember that the same rule applies here like in the Hiragana lesson. That little maru bubble. Just remember that bubbles 'pop' as in the letter 'p'"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- G-Row -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="ga" />
                    <TextView style="@style/GridHeaderStyle" android:text="gi" />
                    <TextView style="@style/GridHeaderStyle" android:text="gu" />
                    <TextView style="@style/GridHeaderStyle" android:text="ge" />
                    <TextView style="@style/GridHeaderStyle" android:text="go" />
                    <TextView style="@style/GridCharStyle" android:text="ガ" />
                    <TextView style="@style/GridCharStyle" android:text="ギ" />
                    <TextView style="@style/GridCharStyle" android:text="グ" />
                    <TextView style="@style/GridCharStyle" android:text="ゲ" />
                    <TextView style="@style/GridCharStyle" android:text="ゴ" />
                </GridLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The G-Row (Heavy K sounds)\nガ ga | ギ gi | グ gu | ゲ ge | ゴ go\n\nEnglish Example: Gasu (ガス) - Gas"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Z-Row -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="za" />
                    <TextView style="@style/GridHeaderStyle" android:text="ji" />
                    <TextView style="@style/GridHeaderStyle" android:text="zu" />
                    <TextView style="@style/GridHeaderStyle" android:text="ze" />
                    <TextView style="@style/GridHeaderStyle" android:text="zo" />
                    <TextView style="@style/GridCharStyle" android:text="ザ" />
                    <TextView style="@style/GridCharStyle" android:text="ジ" />
                    <TextView style="@style/GridCharStyle" android:text="ズ" />
                    <TextView style="@style/GridCharStyle" android:text="ゼ" />
                    <TextView style="@style/GridCharStyle" android:text="ゾ" />
                </GridLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The Z-Row (Heavy S sounds)\nザ za | ジ ji | ズ zu | ゼ ze | ゾ zo\n\nEnglish Example: Jūsu (ジュース) - Juice"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- D-Row -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="da" />
                    <TextView style="@style/GridHeaderStyle" android:text="ji" />
                    <TextView style="@style/GridHeaderStyle" android:text="zu" />
                    <TextView style="@style/GridHeaderStyle" android:text="de" />
                    <TextView style="@style/GridHeaderStyle" android:text="do" />
                    <TextView style="@style/GridCharStyle" android:text="ダ" />
                    <TextView style="@style/GridCharStyle" android:text="ヂ" />
                    <TextView style="@style/GridCharStyle" android:text="ヅ" />
                    <TextView style="@style/GridCharStyle" android:text="デ" />
                    <TextView style="@style/GridCharStyle" android:text="ド" />
                </GridLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The D-Row (Heavy T sounds)\nダ da | ヂ ji | ヅ zu | デ de | ド do\n\nEnglish Example: Dansu (ダンス) - Dance"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- B-Row -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="ba" />
                    <TextView style="@style/GridHeaderStyle" android:text="bi" />
                    <TextView style="@style/GridHeaderStyle" android:text="bu" />
                    <TextView style="@style/GridHeaderStyle" android:text="be" />
                    <TextView style="@style/GridHeaderStyle" android:text="bo" />
                    <TextView style="@style/GridCharStyle" android:text="バ" />
                    <TextView style="@style/GridCharStyle" android:text="ビ" />
                    <TextView style="@style/GridCharStyle" android:text="ブ" />
                    <TextView style="@style/GridCharStyle" android:text="ベ" />
                    <TextView style="@style/GridCharStyle" android:text="ボ" />
                </GridLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The B-Row (Heavy H sounds)\nバ ba | ビ bi | ブ bu | ベ be | ボ bo\n\nEnglish Example: Baggu (バッグ) - Bag"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- P-Row -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="5"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridHeaderStyle" android:text="pa" />
                    <TextView style="@style/GridHeaderStyle" android:text="pi" />
                    <TextView style="@style/GridHeaderStyle" android:text="pu" />
                    <TextView style="@style/GridHeaderStyle" android:text="pe" />
                    <TextView style="@style/GridHeaderStyle" android:text="po" />
                    <TextView style="@style/GridCharStyle" android:text="パ" />
                    <TextView style="@style/GridCharStyle" android:text="ピ" />
                    <TextView style="@style/GridCharStyle" android:text="プ" />
                    <TextView style="@style/GridCharStyle" android:text="ペ" />
                    <TextView style="@style/GridCharStyle" android:text="ポ" />
                </GridLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="The P-Row (H Row + Maru Bubble)\nパ pa | ピ pi | プ pu | ペ pe | ポ po\n\nEnglish Example: Pajama (パジャマ) - Pajamas"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
