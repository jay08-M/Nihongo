<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- Header Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/stylizedNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="漢字"
            android:textColor="#3E6868"
            android:textSize="50sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/inspirationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="Alphabet"
            android:textColor="#5E5E5E"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/stylizedNumber"
            app:layout_constraintTop_toTopOf="@id/stylizedNumber" />

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kanji"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/inspirationLabel"
            app:layout_constraintTop_toBottomOf="@id/inspirationLabel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/headerContainer">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Intro Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kanji_intro_title"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/kanji_intro_text"
                        android:textColor="#CCCCCC"
                        android:textSize="16sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Numbers Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/kanji_numbers_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Numbers Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridCharStyle" android:text="一\n(ichi - 1)" />
                    <TextView style="@style/GridCharStyle" android:text="二\n(ni - 2)" />
                    <TextView style="@style/GridCharStyle" android:text="三\n(san - 3)" />
                    <TextView style="@style/GridCharStyle" android:text="四\n(shi/yon - 4)" />
                    <TextView style="@style/GridCharStyle" android:text="五\n(go - 5)" />
                    <TextView style="@style/GridCharStyle" android:text="六\n(roku - 6)" />
                    <TextView style="@style/GridCharStyle" android:text="七\n(shichi/nana - 7)" />
                    <TextView style="@style/GridCharStyle" android:text="八\n(hachi - 8)" />
                    <TextView style="@style/GridCharStyle" android:text="九\n(kyuu - 9)" />
                    <TextView style="@style/GridCharStyle" android:text="十\n(juu - 10)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nature Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/kanji_nature_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Nature Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridCharStyle" android:text="日\n(hi - Sun)" />
                    <TextView style="@style/GridCharStyle" android:text="月\n(tsuki - Moon)" />
                    <TextView style="@style/GridCharStyle" android:text="火\n(hi - Fire)" />
                    <TextView style="@style/GridCharStyle" android:text="水\n(mizu - Water)" />
                    <TextView style="@style/GridCharStyle" android:text="木\n(ki - Tree)" />
                    <TextView style="@style/GridCharStyle" android:text="金\n(kane - Gold)" />
                    <TextView style="@style/GridCharStyle" android:text="土\n(tsuchi - Earth)" />
                    <TextView style="@style/GridCharStyle" android:text="山\n(yama - Mountain)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Directions & Size Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/kanji_directions_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Directions Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridCharStyle" android:text="上\n(ue - Up)" />
                    <TextView style="@style/GridCharStyle" android:text="下\n(shita - Down)" />
                    <TextView style="@style/GridCharStyle" android:text="左\n(hidari - Left)" />
                    <TextView style="@style/GridCharStyle" android:text="右\n(migi - Right)" />
                    <TextView style="@style/GridCharStyle" android:text="大\n(oo - Big)" />
                    <TextView style="@style/GridCharStyle" android:text="小\n(chii - Small)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- People Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/kanji_people_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- People Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridCharStyle" android:text="人\n(hito - Person)" />
                    <TextView style="@style/GridCharStyle" android:text="男\n(otoko - Man)" />
                    <TextView style="@style/GridCharStyle" android:text="女\n(onna - Woman)" />
                    <TextView style="@style/GridCharStyle" android:text="子\n(ko - Child)" />
                    <TextView style="@style/GridCharStyle" android:text="私\n(watashi - Me/I)" />
                    <TextView style="@style/GridCharStyle" android:text="友\n(tomo - Friend)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Time Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/kanji_time_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Time Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="4dp">
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="1dp"
                    android:background="#CCCCCC">
                    <TextView style="@style/GridCharStyle" android:text="年\n(toshi - Year)" />
                    <TextView style="@style/GridCharStyle" android:text="月\n(getsu - Month)" />
                    <TextView style="@style/GridCharStyle" android:text="日\n(nichi - Day)" />
                    <TextView style="@style/GridCharStyle" android:text="時\n(toki - Time)" />
                </GridLayout>
            </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        app:itemIconTint="#C1AB85"
        app:itemTextColor="#C1AB85"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
